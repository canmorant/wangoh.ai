{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "preview-en",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "start",
        "-p",
        "3100"
      ],
      "port": 3100,
      "env": {
        "NEXT_PUBLIC_SITE_LOCALES": "tr,en"
      }
    },
    {
      "name": "preview-es",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "start",
        "-p",
        "3200"
      ],
      "port": 3200,
      "env": {
        "NEXT_PUBLIC_SITE_LOCALES": "tr,en,es"
      }
    }
  ]
}
