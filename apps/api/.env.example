# Wangoh API ortam değişkenleri (README → Ortam değişkenleri). Kopyala: cp .env.example .env
# apps/api/.env varsa `main.ts` ve `db:seed` açılışta okur (geliştirme kolaylığı). Gerçek ortam değişkenleri her zaman önceliklidir.
# Üretimde değişkenleri platformdan ver; .env dosyası commit'lenmez (kök .gitignore).

PORT=3001
NODE_ENV=development

# Boşsa PGlite (yerel, dosya tabanlı PostgreSQL) kullanılır. Üretimde PostgreSQL adresi ver.
# DATABASE_URL=postgres://kullanici:parola@localhost:5432/wangoh
# PGlite klasörü (varsayılan .data/pglite). Bellek için: memory://
# PGLITE_DIR=.data/pglite

# Üretimde ZORUNLU ve en az 32 karakter (ör: openssl rand -base64 48). Dev/test'te boşsa güvensiz varsayılan kullanılır.
# JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Virgülle ayrılmış izinli kaynaklar. Geliştirmede localhost kaynaklarına her zaman izin verilir.
# CORS_ORIGINS=https://wangoh.com,https://www.wangoh.com
# Ters vekil (Vercel/Render/nginx) arkasında istemci IP'si için: true, atlama sayısı (1), loopback/linklocal/uniquelocal
# ya da virgülle ayrılmış IP/alt ağ listesi (10.0.0.0/8, 192.168.0.0/16). Geçersiz değer açılışta Türkçe hatayla durdurur.
# TRUST_PROXY=1

# İkisi de tanımlıysa açılışta idempotent admin oluşturur (ilk kurulum için).
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Görsel ve bayrak mutlak adresleri için taban adres.
ASSETS_BASE_URL=https://wangoh.com

# Tohum içerik (idempotent). dev/test varsayılanı true, production false.
# SEED_ON_BOOT=true
# Açılışta migrasyon (varsayılan true).
# MIGRATE_ON_BOOT=true
# Swagger arayüzü: /docs ve /docs-json (varsayılan true).
# SWAGGER_ENABLED=true

# İsteğe bağlı: gövde sınırları ve hız sınırı anahtarı.
# BODY_LIMIT=100kb
# BODY_LIMIT_LARGE=1mb
# RATE_LIMIT_ENABLED=true
