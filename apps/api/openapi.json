          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            },
            "description": "Çok fazla istek (hız sınırı)."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Görünen adı günceller",
        "tags": [
          "users"
        ]
      }
    },
    "/v1/users/me/password": {
      "post": {
        "description": "Başarılı olunca tüm oturumlar (bu cihaz dahil) kapanır; istemci yeniden giriş ister.",
        "operationId": "usersChangePassword",
        "parameters": [],
        "requestBody": {
          "content": {
