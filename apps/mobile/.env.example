# Wangoh mobil uygulaması. Yalnız EXPO_PUBLIC_ önekli değişkenler pakete girer ve açık okunur:
# buraya sır (anahtar, parola) yazma.
#
# Yerel kopya için: cp .env.example .env.local

# API adresi (sonda "/" olmasın). Varsayılan: http://localhost:3001
#   iOS simülatörü / web önizleme : http://localhost:3001
#   Android emülatörü             : http://10.0.2.2:3001   (localhost emülatörün kendisidir)
#   Gerçek aygıt                  : http://<bilgisayarın-yerel-ip'si>:3001
#   Yayın sürümü                  : https://... (iOS düz HTTP'yi engeller)
EXPO_PUBLIC_API_URL=http://localhost:3001

# Bileşen galerisini (/ui-kit) yayın sürümünde de açar. Geliştirmede zaten açıktır.
# EXPO_PUBLIC_UI_KIT=1
