{
  "name": "wangoh",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "dev:web": "turbo run dev --filter=web",
    "dev:api": "turbo run dev --filter=api",
    "dev:mobile": "pnpm --filter mobile start",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "generate:api": "pnpm --filter api openapi:export && pnpm --filter @wangoh/api-client generate"
  },
  "devDependencies": {
    "turbo": "^2.11.8"
  },
  "pnpm": {
    "overrides": {
      "@expo/router-server>react-dom": "19.2.3",
      "expo>react-dom": "19.2.3"
    }
  }
}
